fileflow rules disable documents     # Disable rule
fileflow rules create --interactive  # Interactive rule creation

fileflow files large --threshold 100 # Show large files
fileflow files old --days 90         # Show old files

fileflow history --limit 50          # Show operation history

fileflow config export backup.toml   # Export config
fileflow config import backup.toml   # Import config

fileflow detect screenshots          # Detect screenshot location

fileflow daemon --interval 30        # Run as daemon
```

